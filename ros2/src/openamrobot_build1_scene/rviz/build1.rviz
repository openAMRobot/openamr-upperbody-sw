# SPDX-License-Identifier: MIT
# RViz configuration of the Build 1 scene. The README has the checklist that goes with it.
# No goal or velocity tool is in the toolbar: RViz is not a writer of any command topic here.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 20
    Reference Frame: map
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Show Names: false
    Show Axes: true
    Show Arrows: true
    Marker Scale: 0.4
    Frame Timeout: 15
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Description Topic:
      Value: /robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Description Source: Topic
    Visual Enabled: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Topic:
      Value: /map
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Alpha: 0.6
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: false
    Value: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: costmap
    Alpha: 0.5
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Value: true
    Topic:
      Value: /local_costmap/costmap
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Color Scheme: costmap
    Alpha: 0.6
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Value: true
    Topic:
      Value: /local_costmap/published_footprint
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 25; 255; 0
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Value: true
    Topic:
      Value: /scan_filtered
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (m): 0.04
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Value: true
    Topic:
      Value: /odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 1
    Shape:
      Value: Arrow
      Color: 255; 170; 0
      Shaft Length: 0.6
  - Class: rviz_default_plugins/Odometry
    Name: Ground truth
    Enabled: false
    Value: false
    Topic:
      Value: /build1/ground_truth/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 1
    Shape:
      Value: Arrow
      Color: 0; 170; 255
      Shaft Length: 0.6
  - Class: rviz_default_plugins/Image
    Name: Dock camera
    Enabled: false
    Value: false
    Topic:
      Value: /rgb_image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Base depth
    Enabled: false
    Value: false
    Topic:
      Value: /base_camera/rgbd/depth_image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Head depth
    Enabled: false
    Value: false
    Topic:
      Value: /head_camera/rgbd/depth_image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Head camera
    Enabled: false
    Value: false
    Topic:
      Value: /head_camera/rgbd/image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Left wrist camera
    Enabled: false
    Value: false
    Topic:
      Value: /left_wrist_camera/image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Image
    Name: Right wrist camera
    Enabled: false
    Value: false
    Topic:
      Value: /right_wrist_camera/image
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
  - Class: moveit_rviz_plugin/PlanningScene
    Name: PlanningScene
    Enabled: true
    Value: true
    Planning Scene Topic: /monitored_planning_scene
    Robot Description: robot_description
    Scene Geometry:
      Scene Alpha: 0.8
      Scene Name: true
      Show Scene Geometry: true
    Scene Robot:
      Show Robot Visual: false
      Show Robot Collision: false
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Enabled: false
    Value: false
    Move Group Namespace: ''
    Planning Scene Topic: /monitored_planning_scene
    Robot Description: robot_description
    Planning Request:
      Planning Group: left_arm
      Query Goal State: true
      Query Start State: false
  - Class: rviz_default_plugins/Path
    Name: Plan
    Enabled: true
    Value: true
    Topic:
      Value: /plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 0; 0; 255
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/PublishPoint
    Topic:
      Value: /clicked_point
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 9.0
      Pitch: 0.9
      Yaw: 3.9
      Focal Point:
        X: 2.0
        Y: 0.0
        Z: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: null
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: true
