<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  P-03 item 24 upper-body equipment (P-03 rev20.1 item 25 D8; P-03 rev20.2 item 26 for the tablet mount): placeholder
  geometry at the positions the documentation model draws (openamrobot-docs docs/assets/roadmap/model/model.js, blocks
  CHEST-JSON and LIFT-JSON, chestItems() and liftSensors()), with selected supplier envelope corrections recorded in datums.yaml.
  Placeholders until work package M-09.

  Geometry only: fixed joints, boxes and cylinders, neutral visual materials. No logic, no ros2_control, no topics,
  no command authority. The second E-stop and the lift-stop sensors are drawn here as volumes; nothing here reads, wires or
  acts on them.

  Every number is a datum (config/datums.yaml) or option B's configuration (upperbody_configuration.yaml); computed values
  (joint origins, inertia tensors) are computed here and stored nowhere.

    Moving (below lift_joint):
      arm_profile_link  -> getac_tablet_link       Getac ZX80, landscape, screen forward, rear face on the profile front face
                        -> head_light_link         Falcon FLDL-i150x15-W, top edge head_light_gap_below_tablet below the tablet
      head_camera_link (option B's frame)          Stereolabs ZED Mini body box, pitched with the frame
      head_camera_mount_link -> head_camera_bracket_link   placeholder for the OpenArm-supplied mount, profile top to lens line
      adapter_plate_link -> lift_flag_rod_link     MISUMI 20 x 20 rod hanging from the plate underside (frame at its top end)
                            -> lift_flag_link      SS400 flag, lift_flag_gap from the sensor faces
    Static (children of lift_column_base_link):
      second_estop_link                            on the static profile rear face, facing rearward (x = button axis, outward)
      lift_stop_sensor_{l1000,l1175,l1350}_link    SICK IME12 on the left face, frame at the sensing face centre, body along +x,
                                                   with its SICK BEF-WN-M12 bracket envelope

  Called from openamrobot_upperbody.xacro (its `datums` parameter). Frame entries: config/frame_contract.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A uniform solid box: its inertial at the link origin. -->
  <xacro:macro name="openamrobot_equipment_box_inertial" params="mass size">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (size[1] * size[1] + size[2] * size[2]) / 12}" ixy="0" ixz="0"
               iyy="${mass * (size[0] * size[0] + size[2] * size[2]) / 12}" iyz="0"
               izz="${mass * (size[0] * size[0] + size[1] * size[1]) / 12}"/>
    </inertial>
  </xacro:macro>

  <!-- Existing box geometry/pose/collision is unchanged. Named visuals retain their individual URDF finish through SDFormat conversion; no link-wide override recolours the red actuator or dark sensor bodies. -->
  <xacro:macro name="openamrobot_equipment_box" params="name size xyz material:=structural_aluminum collision:=true">
    <visual name="${name}">
      <origin xyz="${xyz[0]} ${xyz[1]} ${xyz[2]}" rpy="0 0 0"/>
      <geometry><box size="${size[0]} ${size[1]} ${size[2]}"/></geometry>
      <xacro:openamr_finish material="${material}"/>
    </visual>
    <xacro:if value="${collision}">
    <collision name="${name}">
      <origin xyz="${xyz[0]} ${xyz[1]} ${xyz[2]}" rpy="0 0 0"/>
      <geometry><box size="${size[0]} ${size[1]} ${size[2]}"/></geometry>
    </collision>
    </xacro:if>
  </xacro:macro>

  <!-- Stereolabs ZED Mini body on head_camera_link (option B's frame on the lens line, pitched by head_pitch), so the box pitches with it:
       datums head_camera_size (x along the optical axis, y across, z up in head_camera_link), head_camera_body_x_from_lens_line, head_camera_mass.
       Called by openamrobot_upperbody.xacro inside its head_camera_link when the combined robot passes the datums. -->
  <xacro:macro name="openamrobot_head_camera_body" params="datums">
    <xacro:property name="cam" lazy_eval="false" value="${datums['datums']['head_camera_size']['value']}"/>
    <xacro:property name="cam_x" lazy_eval="false" value="${datums['datums']['head_camera_body_x_from_lens_line']['value']}"/>
    <xacro:property name="cam_m" lazy_eval="false" value="${datums['datums']['head_camera_mass']['value']}"/>
    <inertial>
      <origin xyz="${cam_x} 0 0" rpy="0 0 0"/>
      <mass value="${cam_m}"/>
      <inertia ixx="${cam_m * (cam[1] * cam[1] + cam[2] * cam[2]) / 12}" ixy="0" ixz="0"
               iyy="${cam_m * (cam[0] * cam[0] + cam[2] * cam[2]) / 12}" iyz="0"
               izz="${cam_m * (cam[0] * cam[0] + cam[1] * cam[1]) / 12}"/>
    </inertial>
    <xacro:openamrobot_equipment_box name="placeholder_head_camera_body" material="equipment_black" size="${cam}" xyz="${[cam_x, 0, 0]}"/>
  </xacro:macro>

  <xacro:macro name="openamrobot_upper_body_equipment" params="datums col geo">
    <xacro:property name="eq" lazy_eval="false" value="${datums['datums']}"/>
    <xacro:property name="profile" lazy_eval="false" value="${geo['arm_profile']}"/>
    <xacro:property name="plate_t" lazy_eval="false" value="${geo['adapter_plate_thickness']}"/>
    <xacro:property name="section" lazy_eval="false" value="${eq['lift_column_section']['value']}"/>
    <xacro:property name="plate_section" lazy_eval="false" value="${eq['adapter_plate_section']['value']}"/>

    <!-- ===== Chest: the Getac tablet and the head light on the arm-profile front face (moving) ===== -->
    <xacro:property name="x_front" lazy_eval="false" value="${eq['chest_equipment_x_from_profile_front_face']['value']}"/>
    <xacro:property name="profile_centre_z" lazy_eval="false" value="${plate_t + profile['length'] / 2}"/>
    <xacro:property name="tablet" lazy_eval="false" value="${eq['getac_tablet_size']['value']}"/>
    <xacro:property name="tablet_z" lazy_eval="false" value="${eq['getac_tablet_z_above_column_top']['value']}"/>
    <xacro:property name="light" lazy_eval="false" value="${eq['head_light_size']['value']}"/>
    <xacro:property name="light_z" lazy_eval="false"
                    value="${tablet_z - tablet[2] / 2 - eq['head_light_gap_below_tablet']['value'] - light[2] / 2}"/>

    <link name="getac_tablet_link">
      <xacro:openamrobot_equipment_box_inertial mass="${eq['getac_tablet_mass']['value']}" size="${tablet}"/>
      <xacro:openamrobot_equipment_box name="placeholder_getac_tablet" material="equipment_black" size="${tablet}" xyz="${[0, 0, 0]}"/>
    </link>

    <joint name="getac_tablet_joint" type="fixed">
      <parent link="arm_profile_link"/>
      <child link="getac_tablet_link"/>
      <origin xyz="${profile['size_x'] / 2 + x_front + tablet[0] / 2} 0 ${tablet_z - profile_centre_z}" rpy="0 0 0"/>
    </joint>

    <link name="head_light_link">
      <xacro:openamrobot_equipment_box_inertial mass="${eq['head_light_mass']['value']}" size="${light}"/>
      <xacro:openamrobot_equipment_box name="placeholder_head_light" material="equipment_metal" size="${light}" xyz="${[0, 0, 0]}"/>
    </link>

    <joint name="head_light_joint" type="fixed">
      <parent link="arm_profile_link"/>
      <child link="head_light_link"/>
      <origin xyz="${profile['size_x'] / 2 + x_front + light[0] / 2} 0 ${light_z - profile_centre_z}" rpy="0 0 0"/>
    </joint>

    <!-- ===== Second E-stop envelope on the static profile rear face (static), facing rearward ===== -->
    <xacro:property name="panel_behind" lazy_eval="false" value="${eq['second_estop_panel_behind_profile']['value']}"/>
    <xacro:property name="es_block" lazy_eval="false" value="${eq['second_estop_contact_block_size']['value']}"/>
    <xacro:property name="es_collar" lazy_eval="false" value="${eq['second_estop_collar_size']['value']}"/>
    <xacro:property name="es_head" lazy_eval="false" value="${eq['second_estop_head_size']['value']}"/>
    <link name="second_estop_link">
      <xacro:openamrobot_equipment_box name="placeholder_second_estop_contact_block" material="equipment_black" size="${es_block}"
                                       xyz="${[-panel_behind + es_block[0] / 2, 0, 0]}"/>
      <xacro:openamrobot_equipment_box name="placeholder_second_estop_collar" material="equipment_metal" size="${es_collar}"
                                       xyz="${[-panel_behind + es_block[0] + es_collar[0] / 2, 0, 0]}"/>
      <xacro:openamrobot_equipment_box name="placeholder_second_estop_head" material="estop_red" size="${es_head}"
                                       xyz="${[-panel_behind + es_block[0] + es_collar[0] + es_head[0] / 2, 0, 0]}"/>
    </link>

    <joint name="second_estop_joint" type="fixed">
      <parent link="lift_column_base_link"/>
      <child link="second_estop_link"/>
      <origin xyz="${-section[0] / 2 - panel_behind} 0 ${col['retracted_length'] - eq['lift_static_profile_top_below_column_top']['value'] - eq['second_estop_below_profile_top']['value']}"
              rpy="0 0 ${pi}"/>
    </joint>

    <!-- ===== Lift-stop sensors and brackets on the static profile left face (static) ===== -->
    <xacro:property name="s_len" lazy_eval="false" value="${eq['lift_stop_sensor_length']['value']}"/>
    <xacro:property name="s_axis_off" lazy_eval="false" value="${eq['lift_stop_sensor_axis_from_face']['value']}"/>
    <xacro:property name="b_leg" lazy_eval="false" value="${eq['lift_sensor_bracket_leg']['value']}"/>
    <xacro:property name="b_t" lazy_eval="false" value="${eq['lift_sensor_bracket_thickness']['value']}"/>
    <xacro:property name="b_h" lazy_eval="false" value="${eq['lift_sensor_bracket_height']['value']}"/>
    <!-- the sensor-carrying leg's front face, from the sensing face along x -->
    <xacro:property name="b_x" lazy_eval="false" value="${s_len - eq['lift_sensor_bracket_sensor_leg_from_back']['value']}"/>
    <xacro:macro name="openamrobot_lift_stop_sensor" params="stop z">
      <link name="lift_stop_sensor_${stop}_link">
        <visual name="lift_stop_sensor_body">
          <origin xyz="${s_len / 2} 0 0" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="${eq['lift_stop_sensor_diameter']['value'] / 2}" length="${s_len}"/></geometry>
          <xacro:openamr_finish material="sensor_dark"/>
        </visual>
        <collision name="placeholder_lift_stop_sensor">
          <origin xyz="${s_len / 2} 0 0" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="${eq['lift_stop_sensor_diameter']['value'] / 2}" length="${s_len}"/></geometry>
        </collision>
        <!-- angle bracket: one leg flat on the profile face, one across the sensor (the sensor passes through it) -->
        <xacro:openamrobot_equipment_box name="placeholder_lift_sensor_bracket_face_leg" size="${[b_leg, b_t, b_h]}"
                                         xyz="${[b_x - b_leg / 2, b_t / 2 - s_axis_off, 0]}"/>
        <!-- Four rectangles approximate the selected 12.2 mm bore with a square
             clearance aperture. Chamfers and slots are omitted, not filled with solid collision. -->
        <xacro:property name="reach" value="${eq['lift_sensor_bracket_face_reach']['value']}"/>
        <xacro:property name="span" value="${reach-b_t}"/>
        <xacro:property name="bore" value="${eq['lift_sensor_bracket_aperture']['value']}"/>
        <xacro:property name="hy" value="${s_axis_off-(reach+b_t)/2}"/>
        <xacro:property name="cy" value="${(reach+b_t)/2-s_axis_off}"/>
        <xacro:openamrobot_equipment_box name="placeholder_lift_sensor_bracket_sensor_leg_top"
            size="${[b_t,span,(b_h-bore)/2]}" xyz="${[b_x-b_t/2,cy,(b_h+bore)/4]}"/>
        <xacro:openamrobot_equipment_box name="placeholder_lift_sensor_bracket_sensor_leg_bottom"
            size="${[b_t,span,(b_h-bore)/2]}" xyz="${[b_x-b_t/2,cy,-(b_h+bore)/4]}"/>
        <xacro:openamrobot_equipment_box name="placeholder_lift_sensor_bracket_sensor_leg_left"
            size="${[b_t,span/2+hy-bore/2,bore]}" xyz="${[b_x-b_t/2,cy+(-span/2+hy-bore/2)/2,0]}"/>
        <xacro:openamrobot_equipment_box name="placeholder_lift_sensor_bracket_sensor_leg_right"
            size="${[b_t,span/2-hy-bore/2,bore]}" xyz="${[b_x-b_t/2,cy+(span/2+hy+bore/2)/2,0]}"/>
      </link>

      <joint name="lift_stop_sensor_${stop}_joint" type="fixed">
        <parent link="lift_column_base_link"/>
        <child link="lift_stop_sensor_${stop}_link"/>
        <origin xyz="${eq['lift_stop_sensor_face_x']['value']} ${section[1] / 2 + s_axis_off} ${z}" rpy="0 0 0"/>
      </joint>
    </xacro:macro>
    <xacro:openamrobot_lift_stop_sensor stop="l1000" z="${eq['lift_stop_sensor_z_l1000']['value']}"/>
    <xacro:openamrobot_lift_stop_sensor stop="l1175" z="${eq['lift_stop_sensor_z_l1175']['value']}"/>
    <xacro:openamrobot_lift_stop_sensor stop="l1350" z="${eq['lift_stop_sensor_z_l1350']['value']}"/>

    <!-- ===== Head camera mount (moving): placeholder for the OpenArm-supplied mount between the camera and the arm-profile top. Its
         dimensions are not stated by any supplier; the values are the docs model's drawing (datums head_camera_bracket_*, placeholder). A foot
         plate on the profile top and a post up to the lens line. It hangs from head_camera_mount_link (the pivot on the lens line, no geometry),
         so it is the camera body's structural neighbour: the drawn post reaches into the pitched body. Frame: foot plate underside centre.
         Visual-only until the mounting geometry is released; no invented physical contact or mass. ===== -->
    <xacro:property name="arm_mount" lazy_eval="false" value="${geo['arm_mount']}"/>
    <xacro:property name="lens_z" lazy_eval="false" value="${arm_mount['z_above_column_top'] + geo['head_camera_lens']['z_above_arm_mount']}"/>
    <xacro:property name="profile_top" lazy_eval="false" value="${plate_t + profile['length']}"/>
    <xacro:property name="foot" lazy_eval="false" value="${eq['head_camera_bracket_foot_size']['value']}"/>
    <xacro:property name="post" lazy_eval="false" value="${eq['head_camera_bracket_post_section']['value']}"/>
    <link name="head_camera_bracket_link">
      <xacro:openamrobot_equipment_box name="placeholder_head_camera_bracket_foot" size="${foot}" xyz="${[0, 0, foot[2] / 2]}" collision="false"/>
      <xacro:openamrobot_equipment_box name="placeholder_head_camera_bracket_post" size="${[post[0], post[1], lens_z - profile_top]}"
                                       xyz="${[0, 0, (lens_z - profile_top) / 2]}" collision="false"/>
    </link>
    <joint name="head_camera_bracket_joint" type="fixed">
      <parent link="head_camera_mount_link"/>
      <child link="head_camera_bracket_link"/>
      <origin xyz="${-eq['head_camera_bracket_x_behind_lens']['value']} 0 ${profile_top - lens_z}" rpy="0 0 0"/>
    </joint>

    <!-- ===== Flag rod and flag (moving), hanging from the adapter plate underside ===== -->
    <xacro:property name="flag" lazy_eval="false" value="${eq['lift_flag_size']['value']}"/>
    <xacro:property name="rod_w" lazy_eval="false" value="${eq['lift_flag_rod_width']['value']}"/>
    <xacro:property name="rod_len" lazy_eval="false" value="${eq['lift_flag_rod_length']['value']}"/>
    <xacro:property name="flag_x_back" lazy_eval="false" value="${eq['lift_stop_sensor_face_x']['value'] - eq['lift_flag_gap']['value'] - flag[0]}"/>
    <!-- rod axis in the carriage frame: behind the flag, outboard of the face by the rod offset -->
    <xacro:property name="rod_x" lazy_eval="false" value="${flag_x_back - rod_w / 2}"/>
    <xacro:property name="rod_y" lazy_eval="false" value="${section[1] / 2 + eq['lift_flag_rod_offset_from_face']['value'] + rod_w / 2}"/>
    <link name="lift_flag_rod_link">
      <xacro:openamrobot_equipment_box name="placeholder_lift_flag_rod" size="${[rod_w, rod_w, rod_len]}" xyz="${[0, 0, -rod_len / 2]}"/>
      <!-- Provisional roadmap mounting corner is part of this rigid rod assembly,
           not another collision body touching the rod. No separate mass is claimed. -->
      <xacro:property name="ct" value="${eq['lift_rod_corner_thickness']['value']}"/>
      <xacro:openamrobot_equipment_box name="placeholder_lift_rod_corner_side"
          size="${[rod_w,ct,rod_w]}" xyz="${[0,-(rod_w+ct)/2,-ct-rod_w/2]}"/>
      <xacro:openamrobot_equipment_box name="placeholder_lift_rod_corner_top"
          size="${[rod_w,rod_w,ct]}" xyz="${[0,-rod_w,-ct/2]}"/>
    </link>

    <joint name="lift_flag_rod_joint" type="fixed">
      <parent link="adapter_plate_link"/>
      <child link="lift_flag_rod_link"/>
      <!-- adapter_plate_link is at the plate's centre: rear edge flush with the column rear face, plate_t / 2 above its underside -->
      <origin xyz="${rod_x - (-section[0] / 2 + plate_section[0] / 2)} ${rod_y} ${-plate_t / 2}" rpy="0 0 0"/>
    </joint>
    <link name="lift_flag_link">
      <xacro:openamrobot_equipment_box name="placeholder_lift_flag" material="flag_steel" size="${flag}" xyz="${[0, 0, 0]}"/>
    </link>

    <joint name="lift_flag_joint" type="fixed">
      <parent link="lift_flag_rod_link"/>
      <child link="lift_flag_link"/>
      <origin xyz="${flag_x_back + flag[0] / 2 - rod_x} ${section[1] / 2 + eq['lift_flag_offset_from_face']['value'] + flag[1] / 2 - rod_y} ${-eq['lift_flag_below_plate']['value']}"
              rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
