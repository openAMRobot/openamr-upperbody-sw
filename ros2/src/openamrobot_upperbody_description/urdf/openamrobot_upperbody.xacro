<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  OpenAMRobot 2.0 upper body, option B (P-03 revision 18.9 item 18, 9 October 2026).

  Lift column on the base plate, prismatic lift joint, lift carriage carrying the
  arm profile, the OpenArm arm mount points (openarm_{left,right}_base_link) and
  the head-camera frames. The upstream openarm_body_link0 is not used; the
  OpenArm arm chains attach at openarm_{side}_base_link.

  All values come from config/upperbody_configuration.yaml. No masses, inertias
  or supplier outlines are modelled: they are pending supplier CAD.

  Two opt-in parameters let the combined robot (combined_robot.xacro) compose this
  model with the upstream OpenArm macro. Both default to this file's own behaviour:
    emit_arm_mounts  true: declare openarm_{left,right}_base_link and their mount
                     joints (frames only, as before). false: declare neither. The
                     upstream arm macro emits a link and a joint of exactly those
                     names, with the arm's own geometry, so declaring them here as
                     well would duplicate them; the combined robot sets false and
                     gives the upstream macro the same parent and origin.
    column_inertial  '' (none): lift_column_base_link carries no inertial. A dict
                     {mass, com_z, ixx, iyy, izz}: it carries that inertial (the
                     combined robot supplies the sourced catalogue mass).
    column_geometry  '' (none): the column has no visual and no collision. A dict
                     {section_x, section_y, inner_x, inner_y}: the two stages of the Hexalift,
                     each a box, visual and collision (the collisions named placeholder_*): the
                     OUTER (fixed) stage of section_x x section_y on lift_column_base_link
                     (retracted length), the INNER (moving) stage of inner_x x inner_y on
                     lift_carriage_link (stroke, below the carriage). The sections are the
                     supplier's (datums lift_column_section and lift_inner_section); the
                     inner stage's length is not, it is the stroke.
    adapter_plate    '' (none): no adapter plate link. A dict {size_x, size_y, center_x}: the
                     plate under the arm profile, its own link adapter_plate_link on
                     lift_carriage_link, size_x fore-aft by size_y lateral by
                     geometry.adapter_plate_thickness, resting on the carriage frame's
                     horizontal plane (the column top at lift 0) and centred laterally;
                     center_x is from the column axis (datum adapter_plate_section).
    datums           '' (none): no equipment. The parsed datums.yaml: the P-03 item 24 equipment
                     of upper_body_equipment.xacro (placeholder geometry, fixed joints only) on
                     arm_profile_link, adapter_plate_link and lift_column_base_link. Needs
                     adapter_plate (the flag rod hangs from it); the combined robot passes both.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find openamrobot_upperbody_description)/urdf/upper_body_equipment.xacro"/>

  <xacro:macro name="openamrobot_upperbody"
      params="parent column base_plate head_pitch base_tilt column_axis_x_bp000 emit_arm_mounts:=true column_inertial:='' column_geometry:='' adapter_plate:='' datums:=''">

    <xacro:property name="cfg" lazy_eval="false"
        value="${xacro.load_yaml('$(find openamrobot_upperbody_description)/config/upperbody_configuration.yaml')}"/>

    <!-- Reject unknown configuration IDs. -->
    <xacro:if value="${column not in cfg['configuration_axes']['column']}">
      ${xacro.fatal("unknown column '" + column + "'; expected one of " + str(cfg['configuration_axes']['column']))}
    </xacro:if>
    <xacro:if value="${base_plate not in cfg['configuration_axes']['base_plate']}">
      ${xacro.fatal("unknown base_plate '" + base_plate + "'; expected one of " + str(cfg['configuration_axes']['base_plate']))}
    </xacro:if>
    <xacro:if value="${head_pitch not in cfg['configuration_axes']['head_pitch']}">
      ${xacro.fatal("unknown head_pitch '" + head_pitch + "'; expected one of " + str(cfg['configuration_axes']['head_pitch']))}
    </xacro:if>
    <xacro:if value="${base_tilt not in cfg['configuration_axes']['base_tilt']}">
      ${xacro.fatal("unknown base_tilt '" + base_tilt + "'; expected one of " + str(cfg['configuration_axes']['base_tilt']))}
    </xacro:if>

    <xacro:property name="col" value="${cfg['column'][column]}" lazy_eval="false"/>
    <xacro:if value="${col['retracted_length'] is None or col['stroke'] is None}">
      ${xacro.fatal("column '" + column + "': retracted length and stroke are pending supplier data; this configuration cannot be built yet")}
    </xacro:if>

    <xacro:property name="geo" value="${cfg['geometry']}" lazy_eval="false"/>
    <xacro:property name="column_x" lazy_eval="false"
        value="${float(column_axis_x_bp000) + cfg['base_plate'][base_plate]['column_axis_offset_x']}"/>
    <xacro:property name="pitch_rad" lazy_eval="false"
        value="${radians(cfg['head_pitch'][head_pitch]['pitch_down_deg'])}"/>
    <xacro:property name="mount" value="${geo['arm_mount']}" lazy_eval="false"/>
    <xacro:property name="lens" value="${geo['head_camera_lens']}" lazy_eval="false"/>
    <xacro:property name="profile" value="${geo['arm_profile']}" lazy_eval="false"/>

    <!-- Presentation only: neutral reference finishes do not assert released hardware geometry.
         Material names are shared by the URDF and Gazebo extensions. -->
    <xacro:property name="openamr_finishes" value="${dict(structural_aluminum='0.63 0.67 0.71 1', adapter_gray='0.25 0.28 0.31 1', equipment_black='0.035 0.045 0.055 1', equipment_metal='0.45 0.48 0.52 1', sensor_dark='0.09 0.10 0.11 1', estop_red='0.80 0.025 0.025 1', flag_steel='0.20 0.22 0.25 1')}"/>
    <xacro:macro name="openamr_finish" params="material">
      <material name="${material}"><color rgba="${openamr_finishes[material]}"/></material>
    </xacro:macro>
    <xacro:macro name="openamr_gazebo_finish" params="link material">
      <gazebo reference="${link}"><visual><material>
        <ambient>${openamr_finishes[material]}</ambient>
        <diffuse>${openamr_finishes[material]}</diffuse>
        <specular>0.15 0.15 0.15 1</specular>
      </material></visual></gazebo>
    </xacro:macro>

    <!-- Column axis on the base-plate top face (height reference, 304 mm). -->
    <link name="lift_column_base_link">
      <xacro:unless value="${column_inertial == ''}">
        <inertial>
          <origin xyz="0 0 ${column_inertial['com_z']}" rpy="0 0 0"/>
          <mass value="${column_inertial['mass']}"/>
          <inertia ixx="${column_inertial['ixx']}" ixy="0" ixz="0" iyy="${column_inertial['iyy']}" iyz="0" izz="${column_inertial['izz']}"/>
        </inertial>
      </xacro:unless>
      <xacro:unless value="${column_geometry == ''}">
        <visual>
          <origin xyz="0 0 ${col['retracted_length'] / 2}" rpy="0 0 0"/>
          <geometry><box size="${column_geometry['section_x']} ${column_geometry['section_y']} ${col['retracted_length']}"/></geometry>
          <xacro:openamr_finish material="structural_aluminum"/>
        </visual>
        <collision name="placeholder_lift_column_fixed_stage">
          <origin xyz="0 0 ${col['retracted_length'] / 2}" rpy="0 0 0"/>
          <geometry><box size="${column_geometry['section_x']} ${column_geometry['section_y']} ${col['retracted_length']}"/></geometry>
        </collision>
      </xacro:unless>
    </link>
    <xacro:unless value="${column_geometry == ''}">
      <xacro:openamr_gazebo_finish material="structural_aluminum" link="lift_column_base_link"/>
    </xacro:unless>
    <joint name="lift_column_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lift_column_base_link"/>
      <origin xyz="${column_x} 0 ${geo['base_plate_top_z']}" rpy="0 0 0"/>
    </joint>

    <!-- Lift carriage: origin on the column axis at the column top. The lift
         height is joint state. Effort and velocity limits are pending: they are
         set to 0 so the model cannot be used to command the lift. -->
    <xacro:if value="${column_geometry == ''}">
      <link name="lift_carriage_link"/>
    </xacro:if>
    <xacro:unless value="${column_geometry == ''}">
      <link name="lift_carriage_link">
        <visual>
          <origin xyz="0 0 ${-col['stroke'] / 2}" rpy="0 0 0"/>
          <geometry><box size="${column_geometry['inner_x']} ${column_geometry['inner_y']} ${col['stroke']}"/></geometry>
          <xacro:openamr_finish material="structural_aluminum"/>
        </visual>
        <collision name="placeholder_lift_column_moving_stage">
          <origin xyz="0 0 ${-col['stroke'] / 2}" rpy="0 0 0"/>
          <geometry><box size="${column_geometry['inner_x']} ${column_geometry['inner_y']} ${col['stroke']}"/></geometry>
        </collision>
      </link>
      <xacro:openamr_gazebo_finish material="structural_aluminum" link="lift_carriage_link"/>
    </xacro:unless>
    <joint name="lift_joint" type="prismatic">
      <parent link="lift_column_base_link"/>
      <child link="lift_carriage_link"/>
      <origin xyz="0 0 ${col['retracted_length']}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0.0" upper="${col['stroke']}" effort="0.0" velocity="0.0"/>
    </joint>

    <!-- Adapter plate (P-03 rev19.6 item 18): its own link, carried by the carriage, under the arm profile. Its joint is at the box centre and
         the link has no <origin>, the convention arm_profile_link uses. The plate rests on the carriage frame's horizontal plane (z 0 to the
         thickness), so the profile's 10 mm offset below is its top face. -->
    <xacro:unless value="${adapter_plate == ''}">
      <link name="adapter_plate_link">
        <visual>
          <geometry><box size="${adapter_plate['size_x']} ${adapter_plate['size_y']} ${geo['adapter_plate_thickness']}"/></geometry>
          <xacro:openamr_finish material="adapter_gray"/>
        </visual>
        <collision name="adapter_plate">
          <geometry><box size="${adapter_plate['size_x']} ${adapter_plate['size_y']} ${geo['adapter_plate_thickness']}"/></geometry>
        </collision>
      </link>
      <xacro:openamr_gazebo_finish material="adapter_gray" link="adapter_plate_link"/>
      <joint name="adapter_plate_joint" type="fixed">
        <parent link="lift_carriage_link"/>
        <child link="adapter_plate_link"/>
        <origin xyz="${adapter_plate['center_x']} 0 ${geo['adapter_plate_thickness'] / 2}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <!-- Arm profile (MISUMI HFS6-60120) on the adapter plate. -->
    <link name="arm_profile_link">
      <visual>
        <geometry><box size="${profile['size_x']} ${profile['size_y']} ${profile['length']}"/></geometry>
        <xacro:openamr_finish material="structural_aluminum"/>
      </visual>
      <collision>
        <geometry><box size="${profile['size_x']} ${profile['size_y']} ${profile['length']}"/></geometry>
      </collision>
    </link>
    <xacro:openamr_gazebo_finish material="structural_aluminum" link="arm_profile_link"/>
    <!-- With the adapter plate modelled the profile hangs off the plate it stands on (P28): the two faces touch by design (the profile's bottom
         face is the plate's top face), and two siblings that touch would be a permanent collision of the model, where a parent and its child are
         a structural neighbour. The profile's pose from the carriage is the same either way: x center_x_from_column_axis, z thickness + length / 2. -->
    <xacro:if value="${adapter_plate == ''}">
      <joint name="arm_profile_joint" type="fixed">
        <parent link="lift_carriage_link"/>
        <child link="arm_profile_link"/>
        <origin xyz="${profile['center_x_from_column_axis']} 0 ${geo['adapter_plate_thickness'] + profile['length'] / 2}" rpy="0 0 0"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${adapter_plate == ''}">
      <joint name="arm_profile_joint" type="fixed">
        <parent link="adapter_plate_link"/>
        <child link="arm_profile_link"/>
        <origin xyz="${profile['center_x_from_column_axis'] - adapter_plate['center_x']} 0 ${geo['adapter_plate_thickness'] / 2 + profile['length'] / 2}" rpy="0 0 0"/>
      </joint>
    </xacro:unless>

    <!-- OpenArm J1_A arm mount points. -->
    <xacro:macro name="openamrobot_arm_mount" params="side sign">
      <link name="openarm_${side}_base_link"/>
      <joint name="openarm_${side}_base_link_mount_joint" type="fixed">
        <parent link="lift_carriage_link"/>
        <child link="openarm_${side}_base_link"/>
        <origin xyz="${mount['x_from_column_axis']} ${sign * mount['y']} ${mount['z_above_column_top']}" rpy="0 0 0"/>
      </joint>
    </xacro:macro>
    <xacro:if value="${emit_arm_mounts}">
      <xacro:openamrobot_arm_mount side="left" sign="1"/>
      <xacro:openamrobot_arm_mount side="right" sign="-1"/>
    </xacro:if>

    <!-- Head camera (ZED Mini). head_camera_mount_link is the pitch pivot on the
         lens line; head_camera_link is pitched down by head_pitch about y. -->
    <!-- Provisional VISUAL-ONLY camera support, from the assembled roadmap's
         head_camera_bracket (model.js cd780d6368625f4c653dfa287efc0688c37be82a).
         Released bracket CAD is pending (upperbody-hw upper_body_option_B.md).
         It adds no link/joint, mass, inertia or collision; its fixed camera-mount
         frame is already carried by the lift. The camera pivot/optical pose is unchanged. -->
    <!-- Visualization constant: roadmap support footprint/width, not a released bracket dimension. -->
    <xacro:property name="openamr_head_support_width" value="0.030"/>
    <!-- Visualization constant: roadmap foot thickness, visual only. -->
    <xacro:property name="openamr_head_support_foot" value="0.006"/>
    <!-- Visualization constant: roadmap stem depth, visual only. -->
    <xacro:property name="openamr_head_support_depth" value="0.012"/>
    <!-- Visualization constant: roadmap setback behind the lens line, visual only. -->
    <xacro:property name="openamr_head_support_setback" value="0.030"/>
    <xacro:property name="head_support_rise" value="${mount['z_above_column_top'] + lens['z_above_arm_mount'] - geo['adapter_plate_thickness'] - profile['length']}"/>
    <link name="head_camera_mount_link">
      <visual>
        <origin xyz="${-openamr_head_support_setback} 0 ${-head_support_rise + openamr_head_support_foot/2}"/>
        <geometry><box size="${openamr_head_support_width} ${openamr_head_support_width} ${openamr_head_support_foot}"/></geometry>
        <xacro:openamr_finish material="structural_aluminum"/>
      </visual>
      <visual>
        <origin xyz="${-openamr_head_support_setback} 0 ${-head_support_rise/2}"/>
        <geometry><box size="${openamr_head_support_depth} ${openamr_head_support_width} ${head_support_rise}"/></geometry>
        <xacro:openamr_finish material="structural_aluminum"/>
      </visual>
    </link>
    <xacro:openamr_gazebo_finish link="head_camera_mount_link" material="structural_aluminum"/>
    <joint name="head_camera_mount_joint" type="fixed">
      <parent link="lift_carriage_link"/>
      <child link="head_camera_mount_link"/>
      <origin xyz="${mount['x_from_column_axis'] + lens['x_ahead_of_arm_mount']} ${lens['y']} ${mount['z_above_column_top'] + lens['z_above_arm_mount']}" rpy="0 0 0"/>
    </joint>
    <link name="head_camera_link"/>
    <joint name="head_camera_pitch_joint" type="fixed">
      <parent link="head_camera_mount_link"/>
      <child link="head_camera_link"/>
      <origin xyz="0 0 0" rpy="0 ${pitch_rad} 0"/>
    </joint>
    <link name="head_camera_optical_frame"/>
    <joint name="head_camera_optical_joint" type="fixed">
      <parent link="head_camera_link"/>
      <child link="head_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>

    <!-- P-03 item 24 equipment (placeholder geometry, P-03 rev20.1 item 25 D8): upper_body_equipment.xacro. -->
    <xacro:unless value="${datums == ''}">
      <xacro:if value="${adapter_plate == ''}">
        ${xacro.fatal("the item 24 equipment needs adapter_plate: the flag rod hangs from adapter_plate_link")}
      </xacro:if>
      <xacro:openamrobot_upper_body_equipment datums="${datums}" col="${col}" geo="${geo}"/>
    </xacro:unless>
  </xacro:macro>
</robot>
