# SPDX-License-Identifier: MIT
# RViz2 configuration of the control room REPLAY (openamrobot_control_room replay.py, launch/replay.launch.py).
# Generated from control_room.rviz: only the displays of recorded topics, each on /control_room/replay/<topic>, plus
# the REPLAY label marker. RViz runs with /tf, /tf_static and /clock remapped to /control_room/replay/ and
# use_sim_time, so it shows the recorded run on its own simulation time and never the live graph.
# Read only, as control_room.rviz: test/test_static.py checks it with readonly.rviz_violations.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Tree Height: 560
  Splitter Ratio: 0.5
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Value: true
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: REPLAY Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 20
    Reference Frame: map
  - Class: rviz_default_plugins/TF
    Name: REPLAY TF
    Enabled: false
    Value: false
    Show Names: false
    Marker Scale: 0.4
    Frame Timeout: 15
  - Class: rviz_default_plugins/RobotModel
    Name: REPLAY Robot model
    Enabled: true
    Value: true
    Description Source: Topic
    Description Topic:
      Value: /control_room/replay/robot_description
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Visual Enabled: true
  - Class: rviz_default_plugins/Polygon
    Name: REPLAY Footprint
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/local_costmap/published_footprint
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 25; 255; 0
  - Class: rviz_default_plugins/LaserScan
    Name: REPLAY LiDAR /scan_filtered
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/scan_filtered
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Size (m): 0.04
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 0; 0
  - Class: rviz_default_plugins/Odometry
    Name: REPLAY Odometry /odom
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 1
    Shape:
      Value: Arrow
      Color: 255; 170; 0
      Shaft Length: 0.6
  - Class: rviz_default_plugins/Odometry
    Name: REPLAY Ground truth (Gazebo)
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/build1/ground_truth/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Keep: 1
    Shape:
      Value: Arrow
      Color: 0; 170; 255
      Shaft Length: 0.6
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: REPLAY AMCL pose
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/amcl_pose
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Shape: Arrow
    Color: 255; 25; 0
    Covariance:
      Value: true
  - Class: rviz_default_plugins/Pose
    Name: REPLAY Nav2 goal (end of /plan)
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/control_room/nav_goal
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Shape: Axes
    Axes Length: 0.4
    Axes Radius: 0.04
  - Class: rviz_default_plugins/Path
    Name: REPLAY Global plan /plan
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 0; 0; 255
  - Class: rviz_default_plugins/Path
    Name: REPLAY Local plan /local_plan
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/local_plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Color: 0; 200; 200
  - Class: rviz_default_plugins/Pose
    Name: REPLAY Item (ground truth)
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/build1/ground_truth/item/pose
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Shape: Axes
    Axes Length: 0.15
    Axes Radius: 0.015
  - Class: rviz_default_plugins/MarkerArray
    Name: REPLAY label (phase, verdict, recorded time)
    Enabled: true
    Value: true
    Topic:
      Value: /control_room/replay/label
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces:
      replay: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8.0
      Pitch: 0.8
      Yaw: 3.9
      Focal Point:
        X: 1.5
        Y: 0.8
        Z: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: null
Window Geometry:
  Height: 1000
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: true
