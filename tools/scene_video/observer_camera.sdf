<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Fixed observer camera for the scene video only (.github/workflows/scene-video.yml). Visual capture, not a test
     result. Not part of the robot model. Pose: about 3.5 m from (0.8, 0, 0.8) at 20 deg elevation, from the front
     right of the drive line. -->
<sdf version="1.9">
  <model name="observer_camera">
    <static>true</static>
    <pose>1.925 -3.091 1.997 0 0.349 1.920</pose>
    <link name="link">
      <sensor name="observer" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/observer/image</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>40</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
