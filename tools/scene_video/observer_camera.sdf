<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<!-- Fixed observer camera for the scene video only (.github/workflows/scene-video.yml). Visual capture, not a test
     result. Not part of the robot model. 1.6 m high, pitched down 15 deg, 4.5 m from the middle of the 1.6 m drive
     line (0.8, 0), from the front right: the whole drive and turn stay in frame. A fill light from the camera side. -->
<sdf version="1.9">
  <model name="observer_camera">
    <static>true</static>
    <pose>2.287 -4.085 1.6 0 0.2618 1.9199</pose>
    <link name="link">
      <light type="directional" name="observer_fill">
        <cast_shadows>false</cast_shadows>
        <diffuse>0.6 0.6 0.6 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <direction>1 0 -0.4</direction>
      </light>
      <sensor name="observer" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/observer/image</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>40</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
